{
  "buildCommand": "cd admin_dashboard && npm install && npm run build",
  "outputDirectory": "admin_dashboard/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
